@page "/donations/edit/{Id:int}"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Uredi donaciju</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4" MaxWidth="600px">
        <MudSelect T="int" Label="Donator" @bind-Value="model.DonorId" Required="true" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var donor in donors)
            {
                <MudSelectItem T="int" Value="@donor.Id">@donor.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Label="Tip donacije" @bind-Value="model.DonationTypeId" Required="true" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var type in types)
            {
                <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Label="Status" @bind-Value="model.DonationStatusId" Required="true" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var status in statuses)
            {
                <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudDatePicker Label="Datum donacije" @bind-Date="donationDate" Required="true" Variant="Variant.Outlined" Class="mb-3" />

        @if (IsMonetary)
        {
            <MudNumericField T="decimal?" Label="Iznos (€)" @bind-Value="model.Amount" Variant="Variant.Outlined" Class="mb-3" />
        }
        else
        {
            <MudTextField Label="Naziv stvari" @bind-Value="model.ItemName" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField T="decimal?" Label="Količina" @bind-Value="model.Quantity" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField T="decimal?" Label="Procijenjena vrijednost (€)" @bind-Value="model.EstimatedValue" Variant="Variant.Outlined" Class="mb-3" />
        }

        <MudTextField Label="Napomena" @bind-Value="model.Notes" Lines="3" Variant="Variant.Outlined" Class="mb-4" />

        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">AI zahvala donatoru</MudText>
            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                <MudSelect T="string" Label="Ton poruke" @bind-Value="selectedTone" Variant="Variant.Outlined">
                    <MudSelectItem Value='@("Topao")'>Topao</MudSelectItem>
                    <MudSelectItem Value='@("Formalan")'>Formalan</MudSelectItem>
                    <MudSelectItem Value='@("Kratak")'>Kratak</MudSelectItem>
                </MudSelect>
                <MudButton ButtonType="ButtonType.Button"
                           OnClick="GenerateThankYou"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Disabled="isGeneratingThankYou">
                    @(isGeneratingThankYou ? "Generiram..." : "Generiraj zahvalu")
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(thankYouText))
            {
                <MudTextField @bind-Value="thankYouText"
                              Label="Uredivi prijedlog poruke"
                              Lines="4"
                              Variant="Variant.Outlined"
                              Class="mt-3" />
            }
        </MudPaper>

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Spremi promjene</MudButton>
            <MudButton Href="/donations" Variant="Variant.Text">Odustani</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private SaveDonationDto model = new();
    private DateTime? donationDate;

    private List<LookupDto> donors = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();

    private bool isLoading = true;
    private string? errorMessage;

    private bool IsMonetary =>
        types.FirstOrDefault(t => t.Id == model.DonationTypeId)?.Name == "Novčana";

    private string selectedTone = "Topao";
    private string? thankYouText;
    private bool isGeneratingThankYou;

    private async Task GenerateThankYou()
    {
        isGeneratingThankYou = true;
        errorMessage = null;

        try
        {
            var donorName = donors
                .FirstOrDefault(item => item.Id == model.DonorId)?.Name
                ?? "Donator";

            var donationType = types
                .FirstOrDefault(item => item.Id == model.DonationTypeId)?.Name
                ?? "Donacija";

            var donationValue = model.Amount.HasValue
                ? $"{model.Amount.Value:N2} €"
                : string.IsNullOrWhiteSpace(model.ItemName)
                    ? "nije navedena"
                    : model.ItemName;

            var response = await Http.PostAsJsonAsync("api/ai/text", new AiTextRequestDto
            {
                Purpose = "donor-thank-you",
                Input =
                    $"Ton: {selectedTone}; Donator: {donorName}; " +
                    $"Tip donacije: {donationType}; Vrijednost ili sadržaj: {donationValue}; " +
                    $"Datum: {model.DonationDate:d}."
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AiTextResponseDto>();
            thankYouText = result?.Text;
        }
        catch (Exception ex)
        {
            errorMessage = $"Zahvalu nije moguće generirati: {ex.Message}";
        }
        finally
        {
            isGeneratingThankYou = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            donors = await Http.GetFromJsonAsync<List<LookupDto>>("api/donors/lookup") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationtypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationstatuses") ?? new();

            var existing = await Http.GetFromJsonAsync<DonationDto>($"api/donations/{Id}");
            if (existing is null)
            {
                errorMessage = "Donacija nije pronađena.";
                return;
            }

            model = new SaveDonationDto
            {
                DonorId = existing.DonorId,
                DonationTypeId = existing.DonationTypeId,
                DonationStatusId = existing.DonationStatusId,
                DonationDate = existing.DonationDate,
                Amount = existing.Amount,
                ItemName = existing.ItemName,
                Quantity = existing.Quantity,
                EstimatedValue = existing.EstimatedValue,
                Notes = existing.Notes
            };
            donationDate = existing.DonationDate;
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja donacije: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        errorMessage = ValidateForm();
        if (errorMessage is not null)
            return;

        model.DonationDate = donationDate ?? DateTime.Today;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/donations/{Id}", model);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Navigation.NavigateTo("/donations");
        }
        catch (Exception ex)
        {
            errorMessage = $"Promjene nije moguće spremiti: {ex.Message}";
        }
    }

    private string? ValidateForm()
    {
        if (model.DonorId <= 0 || model.DonationTypeId <= 0 || model.DonationStatusId <= 0)
            return "Donator, tip i status su obavezni.";

        if (!donationDate.HasValue)
            return "Odaberi datum donacije.";

        if (donationDate.Value.Date > DateTime.Today)
            return "Datum donacije ne smije biti u budućnosti.";

        if (model.Quantity.HasValue && model.Quantity.Value < 0)
            return "Količina ne smije biti negativna.";

        if (model.EstimatedValue.HasValue && model.EstimatedValue.Value < 0)
            return "Procijenjena vrijednost ne smije biti negativna.";

        if (IsMonetary)
        {
            if (!model.Amount.HasValue || model.Amount.Value <= 0)
                return "Za novčanu donaciju upiši iznos veći od nule.";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(model.ItemName))
                return "Upiši naziv materijalne donacije.";

            if (!model.Quantity.HasValue || model.Quantity.Value <= 0)
                return "Upiši količinu veću od nule.";
        }

        return null;
    }
}