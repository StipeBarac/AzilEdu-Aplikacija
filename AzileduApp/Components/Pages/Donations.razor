@page "/donations"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http

<MudText Typo="Typo.h4" Class="mb-4">Donacije</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

<MudButton Href="/donations/create" Variant="Variant.Filled" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
    Nova donacija
</MudButton>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudTextField Label="Pretraga" @bind-Value="searchString" Immediate="true"
                          Placeholder="Donator, naziv stvari ili napomena" Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Tip" @bind-Value="selectedTypeId" Variant="Variant.Outlined" Clearable="true">
                @foreach (var type in types)
                {
                    <MudSelectItem T="int?" Value="@((int?)type.Id)">@type.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Status" @bind-Value="selectedStatusId" Variant="Variant.Outlined" Clearable="true">
                @foreach (var status in statuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Donator" @bind-Value="selectedDonorId" Variant="Variant.Outlined" Clearable="true">
                @foreach (var donor in donors)
                {
                    <MudSelectItem T="int?" Value="@((int?)donor.Id)">@donor.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudDatePicker Label="Datum od" @bind-Date="dateFrom" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudDatePicker Label="Datum do" @bind-Date="dateTo" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>

        <MudItem xs="12" md="6" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadDonations" Class="mr-2">
                Primijeni filtere
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetFilters">
                Reset filtera
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <MudTable Items="FilteredDonations" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Donator</MudTh>
            <MudTh>Tip</MudTh>
            <MudTh>Status</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DonationDto, object>(x => x.DonationDate)">Datum</MudTableSortLabel></MudTh>
            <MudTh>Iznos / Stvar</MudTh>
            <MudTh>Akcije</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Donator">@context.DonorName</MudTd>
            <MudTd DataLabel="Tip">@context.TypeName</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.StatusName)">@context.StatusName</MudChip>
            </MudTd>
            <MudTd DataLabel="Datum">@context.DonationDate.ToString("dd.MM.yyyy.")</MudTd>
            <MudTd DataLabel="Iznos / Stvar">
                @if (context.DonationTypeId == 1)
                {
                    <span>@(context.Amount?.ToString("0.00") ?? "-") €</span>
                }
                else
                {
                    <span>
                        @context.ItemName
                        @if (context.Quantity.HasValue)
                        {
                            <text> (kol: @context.Quantity)</text>
                        }
                        @if (context.EstimatedValue.HasValue)
                        {
                            <text> — proc. @context.EstimatedValue.Value.ToString("0.00") €</text>
                        }
                    </span>
                }
            </MudTd>
            <MudTd DataLabel="Akcije">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                               Href="@($"/donations/edit/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                               OnClick="@(() => DeleteDonation(context.Id))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body1" Class="pa-4">Nema donacija za odabrane filtere.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<DonationDto> donations = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();
    private List<LookupDto> donors = new();

    private string searchString = string.Empty;
    private int? selectedTypeId;
    private int? selectedStatusId;
    private int? selectedDonorId;
    private DateTime? dateFrom;
    private DateTime? dateTo;

    private bool isLoading = true;
    private string? errorMessage;

    private IEnumerable<DonationDto> FilteredDonations =>
        donations.Where(DonationMatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationtypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationstatuses") ?? new();
            donors = await Http.GetFromJsonAsync<List<LookupDto>>("api/donors/lookup") ?? new();
            await LoadDonations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja stranice: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadDonations()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var query = new List<string>();
            if (selectedTypeId.HasValue) query.Add($"typeId={selectedTypeId.Value}");
            if (selectedStatusId.HasValue) query.Add($"statusId={selectedStatusId.Value}");
            if (selectedDonorId.HasValue) query.Add($"donorId={selectedDonorId.Value}");
            if (dateFrom.HasValue) query.Add($"dateFrom={dateFrom.Value:yyyy-MM-dd}");
            if (dateTo.HasValue) query.Add($"dateTo={dateTo.Value:yyyy-MM-dd}");

            var url = "api/donations";
            if (query.Count > 0)
                url += "?" + string.Join("&", query);

            donations = await Http.GetFromJsonAsync<List<DonationDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod dohvaćanja donacija: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilters()
    {
        searchString = string.Empty;
        selectedTypeId = null;
        selectedStatusId = null;
        selectedDonorId = null;
        dateFrom = null;
        dateTo = null;
        await LoadDonations();
    }

    private bool DonationMatchesSearch(DonationDto d)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var term = searchString.Trim();
        return d.DonorName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || d.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || d.Notes.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private async Task DeleteDonation(int id)
    {
        var response = await Http.DeleteAsync($"api/donations/{id}");
        if (response.IsSuccessStatusCode)
        {
            donations = donations.Where(d => d.Id != id).ToList();
        }
        else
        {
            errorMessage = "Donaciju nije moguće obrisati.";
        }
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "Evidentirana" => Color.Info,
            "Potvrđena" => Color.Success,
            "Iskorištena" => Color.Primary,
            "Otkazana" => Color.Error,
            _ => Color.Default
        };
    }
}