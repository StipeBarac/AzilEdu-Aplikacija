@page "/housing-units"
@rendermode InteractiveServer
@using AzilEdu.Shared.Models

<PageTitle>Smještajne Jedinice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Popis smještaja</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Ovdje se prikazuje pregled svih smještajnih jednica koje se nalaze u azilu.
</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan broj jedinica</MudText>
            <MudText Typo="Typo.h5">@TotalUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2"> Broj aktivnih jedinica</MudText>
            <MudText Typo="Typo.h5">@ActiveUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj punih jedinica</MudText>
            <MudText Typo="Typo.h5">@FullUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan slobodni kapacitet</MudText>
            <MudText Typo="Typo.h5">@TotaFreeCapacity</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="@ShowAllUnits">Sve jedinice</MudButton>
    <MudButton OnClick="@ShowActiveUnits">Aktivne jedince</MudButton>
    <MudButton OnClick="@ShowFullUnits">Pune jedinice</MudButton>
    <MudButton OnClick="@ShowFreeUnits">Jedinice sa slobodnim mjestima</MudButton>
</MudButtonGroup>



<MudTable Items="@FilteredUnits" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Naziv">@context.Name</MudTd>
        <MudTd DataLabel="Tip">@context.UnitType</MudTd>
        <MudTd DataLabel="Kapacitet">@context.Capacity</MudTd>
        <MudTd DataLabel="Zauzeto">@context.Occupied</MudTd>
        <MudTd DataLabel="Slobodno">@GetFreeCapacity(context)</MudTd>                      @* Ovdje sada pozivmo funkciju iz code dijela, a ne pisemo samo @context.Age*@
        <MudTd DataLabel="Zadnje čišćenje">@GetCleaningDateText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetUnitStatusColor(context)"
                     Variant="Variant.Filled">
                @GetUnitStatusText(context)
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {


    private int TotalUnits => housingUnits.Count;
    private int ActiveUnits => housingUnits.Count(unit => unit.IsActive);
    private int FullUnits => housingUnits.Count(unit => (unit.Capacity - unit.Occupied) == 0);
    private int TotaFreeCapacity => housingUnits.Sum(unit => (unit.Capacity - unit.Occupied));
    private string status = "sve";

    private IEnumerable<HousingUnit> FilteredUnits => 
       status switch{
           "Aktivne"  => housingUnits.Where(unit => unit.IsActive),
           "Pune"     => housingUnits.Where(unit => (unit.Capacity - unit.Occupied) == 0),
           "Slobodne" => housingUnits.Where(unit => unit.IsActive && (unit.Capacity - unit.Occupied) > 0),
           _          => housingUnits
       };

    private void ShowActiveUnits()
    {
        status = "Aktivne";
    }

    private void ShowFullUnits()
    {
        status = "Pune";
    }
    
    private void ShowFreeUnits()
    {
        status = "Slobodne";
    }

    private void ShowAllUnits()
    {
        status = "sve";
    }
          



    private int GetFreeCapacity(HousingUnit unit)
    {
        return unit.Capacity - unit.Occupied;
    }

    private string GetCleaningDateText(HousingUnit unit)
    {
        if (unit.LastCleanedAt.HasValue)
        {
            return unit.LastCleanedAt.Value.ToShortDateString();
        }

        return "Nije uneseno";
    }


    private string GetUnitStatusText(HousingUnit unit)
    {
        if (!unit.IsActive)
        {
            return "Neaktivno";
        }

        if (unit.Occupied >= unit.Capacity)
        {
            return "Puno";
        }

        return "Slobodno";
    }






    private Color GetUnitStatusColor(HousingUnit unit)
    {
        if (!unit.IsActive)
            return Color.Default;                   // nedostupno — sivo

        if (unit.Occupied == unit.Capacity)
            return Color.Error;                     // puno — crveno

        return Color.Success;                       // slobodno — zeleno
    }



    private List<HousingUnit> housingUnits = new()
    {
        new HousingUnit
        {
            Id = 1,
            Name = "Boks A1",
            UnitType = "Boks",
            Capacity = 4,
            Occupied = 4,                                  // PUN
            LastCleanedAt = new DateTime(2026, 7, 15),
            IsActive = true,
            ImageUrl = "images/HousingUnits/boks-a1.jpg",
            Note = "Veliki psi, pristup vanjskom dvorištu."
        },
        new HousingUnit
        {
            Id = 2,
            Name = "Boks A2",
            UnitType = "Boks",
            Capacity = 3,
            Occupied = 1,                                  // ima mjesta
            LastCleanedAt = new DateTime(2026, 7, 13),
            IsActive = true,
            ImageUrl = "images/HousingUnits/boks-a2.jpg",
            Note = "Mirniji boks, pogodan za starije pse."
        },
        new HousingUnit
        {
            Id = 3,
            Name = "Mačja soba B1",
            UnitType = "Soba",
            Capacity = 6,
            Occupied = 4,
            LastCleanedAt = null,                          // nepoznato
            IsActive = true,
            ImageUrl = "images/HousingUnits/soba-b1.jpg",
            Note = "Penjalice za mačke."
        },
        new HousingUnit
        {
            Id = 4,
            Name = "Mačja soba B2",
            UnitType = "Soba",
            Capacity = 4,
            Occupied = 4,                                  // PUN
            LastCleanedAt = new DateTime(2026, 7, 16),
            IsActive = true,
            ImageUrl = "images/HousingUnits/soba-b2.jpg",
            Note = "Trenutno popunjeno, čeka se udomljavanje."
        },
        new HousingUnit
        {
            Id = 5,
            Name = "Karantena K1",
            UnitType = "Karantena",
            Capacity = 2,
            Occupied = 1,
            LastCleanedAt = new DateTime(2026, 7, 14),
            IsActive = true,
            ImageUrl = "images/HousingUnits/karantena-k1.jpg",
            Note = "Novopristigle životinje, obavezan pregled."
        },
        new HousingUnit
        {
            Id = 6,
            Name = "Boks C3",
            UnitType = "Boks",
            Capacity = 5,
            Occupied = 0,                                  // neaktivan → prazan
            LastCleanedAt = new DateTime(2026, 6, 18),
            IsActive = false,                              // NEAKTIVNA
            ImageUrl = "images/HousingUnits/boks-c3.jpg",
            Note = "Zatvoren zbog sanacije poda."
        }
        
    };
}