@page "/donors/create"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Novi donator</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4" MaxWidth="600px">
        <MudTextField Label="Ime" @bind-Value="model.FirstName" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Prezime" @bind-Value="model.LastName" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Naziv organizacije" @bind-Value="model.OrganizationName" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Email" @bind-Value="model.Email" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Telefon" @bind-Value="model.Phone" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Adresa" @bind-Value="model.Address" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Grad" @bind-Value="model.City" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField Label="Napomena" @bind-Value="model.Notes" Lines="3" Variant="Variant.Outlined" Class="mb-3" />

        <MudSelect T="int" Label="Tip donatora" @bind-Value="model.DonorTypeId"
                   Required="true" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var type in types)
            {
                <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Label="Status" @bind-Value="model.DonorStatusId"
                   Required="true" Variant="Variant.Outlined" Class="mb-4">
            @foreach (var status in statuses)
            {
                <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Spremi</MudButton>
        <MudButton Href="/donors" Variant="Variant.Text" Class="ml-2">Odustani</MudButton>
    </MudPaper>
}

@code {
    private SaveDonorDto model = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/donortypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/donorstatuses") ?? new();

            model.DonorTypeId = types.FirstOrDefault()?.Id ?? 0;
            model.DonorStatusId = statuses.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja forme: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        errorMessage = null;

        if (model.DonorTypeId == 0)
        {
            errorMessage = "Tip donatora je obavezan.";
            return;
        }

        if (model.DonorStatusId == 0)
        {
            errorMessage = "Status donatora je obavezan.";
            return;
        }

        var response = await Http.PostAsJsonAsync("api/donors", model);

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Donator nije spremljen.";
            return;
        }

        Navigation.NavigateTo("/donors?poruka=Donator je uspješno kreiran.");
    }
}s