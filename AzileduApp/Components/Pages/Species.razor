@page "/species"

<MudText Typo="Typo.h3" GutterBottom="true">Species</MudText>
<MudText Typo="Typo.body1" GutterBottom="true">
    - U ovom dijelu stranice se prikazuju sve vrste životinja koje se nalaze u azilu
</MudText>
<MudText Typo="Typo.body1" GutterBottom="true"> - Klikom na opciju "Prikaži sve" korisnik će biti preusmjeren na stranicu sa detaljnim pregledom svih životinja izabrane vrste.</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4"> Naziv vrste: Psi </MudText>
            <MudText Typo ="Typo.body2"> Latinski naziv: Canis lupus familiaris</MudText>
            <MudText Typo="Typo.body2"> Prosječan životni vijek: 10-15 godina</MudText>
            <MudText Typo="Typo.body2"> Prehrana: Mesojed</MudText>
            <MudText Typo="Typo.body2" GutterBottom="true"> Broj jedinki u azilu: 9</MudText>

            <MudImage Src="images/pas.jpg" Alt="Glodavac" Width="300" Class="mb-5"></MudImage>
            <br />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3">
                Prikaži sve
            </MudButton>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4"> Naziv vrste: Mačke </MudText>
                <MudText Typo="Typo.body2"> Latinski naziv: Felis catus</MudText>
                <MudText Typo="Typo.body2"> Prosječan životni vijek: 12-18 godina</MudText>
                <MudText Typo="Typo.body2"> Prehrana: Mesojed</MudText>
                <MudText Typo="Typo.body2"> Broj jedinki u azilu: 14</MudText>
            <MudText Typo="Typo.body2" GutterBottom="true"> Pregled svih mačaka koje se nalaze u azilu </MudText>
            
            <MudImage Src="images/macka.jpg" Alt="Glodavac" Width="300" Class="mb-5"></MudImage>
            <br />
            <MudButton Variant="Variant.Filled" Color = "Color.Secondary" Class="mt-3">
                Prikaži sve
            </MudButton>
            
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4"> Naziv vrste: Ptice </MudText>
            <MudText Typo="Typo.body2"> Latinski naziv: Aves</MudText>
            <MudText Typo="Typo.body2"> Prosječan životni vijek: 5-20 godina</MudText>
            <MudText Typo="Typo.body2"> Prehrana: Svejed</MudText>
            <MudText Typo="Typo.body2" GutterBottom="true"> Broj jedinki u azilu: 3</MudText>
            
            <MudImage Src="images/ptica.jpg" Alt="Glodavac" Width="300" Class="mb-5"></MudImage>
            <br />
            <MudButton Variant = "Variant.Filled" Color = "Color.Secondary" Class ="mt-3">
                Prikaži sve
            </MudButton>
            
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4"> Naziv vrste: Glodavci </MudText>
            <MudText Typo="Typo.body2"> Latinski naziv: Rodentia</MudText>
            <MudText Typo="Typo.body2"> Prosječan životni vijek: 2-8 godina</MudText>
            <MudText Typo="Typo.body2"> Prehrana: Biljojed</MudText>
            <MudText Typo="Typo.body2"> Broj jedinki u azilu: 6</MudText>
            
            <MudImage Src ="images/glodavac.jpg" Alt ="Glodavac" Width ="300" Class="mb-5"></MudImage>
            <br />
            <MudButton Variant = "Variant.Filled" Color = "Color.Secondary" Class ="mt-3">
                Prikaži sve
            </MudButton>


            
        </MudPaper>
    </MudItem>
</MudGrid>