@page "/volunteer-tasks"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudText Typo="Typo.h4" Class="mb-4">Volonterski zadaci</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@successMessage</MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudTextField Label="Pretraga" @bind-Value="searchString" Immediate="true" Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Status" @bind-Value="selectedStatusId" Variant="Variant.Outlined" Clearable="true">
                @foreach (var status in statuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Tip zadatka" @bind-Value="selectedTypeId" Variant="Variant.Outlined" Clearable="true">
                @foreach (var type in types)
                {
                    <MudSelectItem T="int?" Value="@((int?)type.Id)">@type.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?"
                       Label="Volonter"
                       @bind-Value="selectedVolunteerId"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var volunteer in volunteers)
                {
                    <MudSelectItem T="int?" Value="@((int?)volunteer.Id)">@volunteer.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?"
                       Label="Životinja"
                       @bind-Value="selectedAnimalId"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var animal in animals)
                {
                    <MudSelectItem T="int?" Value="@((int?)animal.Id)">@animal.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudDatePicker Label="Rok od" @bind-Date="dueFrom" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudDatePicker Label="Rok do" @bind-Date="dueTo" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" @bind-Value="onlyOverdue" Label="Samo istekli rokovi" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadTasks">
            Primijeni filtere
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetFilters">
            Reset filtera
        </MudButton>
    </MudStack>
</MudPaper>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <MudButton Href="/volunteer-tasks/create"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Class="mb-3">
        Novi zadatak
    </MudButton>

    <MudTable Items="FilteredTasks" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Naslov</MudTh>
            <MudTh>Tip</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Volonter</MudTh>
            <MudTh>Životinja</MudTh>
            <MudTh>Rok</MudTh>
            <MudTh>Akcije</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Naslov">@context.Title</MudTd>
            <MudTd DataLabel="Tip">@context.Type</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Volonter">
                @(string.IsNullOrWhiteSpace(context.VolunteerName) ? "Nije dodijeljen volonter" : context.VolunteerName)
            </MudTd>
            <MudTd DataLabel="Životinja">
                @(string.IsNullOrWhiteSpace(context.AnimalName) ? "Nije vezano uz životinju" : context.AnimalName)
            </MudTd>
            <MudTd DataLabel="Rok">
                @if (context.DueDate is null)
                {
                    <span>-</span>
                }
                else if (IsOverdue(context))
                {
                    <MudText Color="Color.Error" Inline="true">
                        @context.DueDate.Value.ToString("dd.MM.yyyy.") (isteklo)
                    </MudText>
                }
                else
                {
                    <span>@context.DueDate.Value.ToString("dd.MM.yyyy.")</span>
                }
            </MudTd>
            <MudTd DataLabel="Akcije">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Href="@($"/volunteer-tasks/edit/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteTask(context.Id))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body1" Class="pa-4">Nema zadataka za odabrane filtere.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<VolunteerTaskDto> tasks = new();
    private List<LookupDto> statuses = new();
    private List<LookupDto> types = new();
    private List<LookupDto> volunteers = new();
    private List<LookupDto> animals = new();

    private string searchString = string.Empty;
    private string? selectedStatus;

    private int? selectedVolunteerId;
    private int? selectedAnimalId;
    private int? selectedStatusId;
    private int? selectedTypeId;
    private DateTime? dueFrom;
    private DateTime? dueTo;
    private bool onlyOverdue;

    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    private IEnumerable<VolunteerTaskDto> FilteredTasks =>
        tasks.Where(TaskMatchesSearch)
             .Where(TaskMatchesOverdue);

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var poruka = queryParams["poruka"];
        if (!string.IsNullOrWhiteSpace(poruka))
        {
            successMessage = poruka;
        }

        try
        {
            await LoadLookups();
            await LoadTasks();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja stranice: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadLookups()
    {
        statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteertaskstatuses") ?? new();
        types = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteertasktypes") ?? new();
        volunteers = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteers/lookup") ?? new();
        animals = await Http.GetFromJsonAsync<List<LookupDto>>("api/animals/lookup") ?? new();
    }

    private async Task LoadTasks()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var query = new List<string>();

            if (selectedStatusId.HasValue)
                query.Add($"statusId={selectedStatusId.Value}");
            if (selectedTypeId.HasValue)
                query.Add($"typeId={selectedTypeId.Value}");
            if (selectedVolunteerId.HasValue)
                query.Add($"volunteerId={selectedVolunteerId.Value}");
            if (selectedAnimalId.HasValue)
                query.Add($"animalId={selectedAnimalId.Value}");
            if (dueFrom.HasValue)
                query.Add($"dateFrom={dueFrom.Value:yyyy-MM-dd}");
            if (dueTo.HasValue)
                query.Add($"dateTo={dueTo.Value:yyyy-MM-dd}");

            var url = "api/volunteertasks";
            if (query.Count > 0)
                url += "?" + string.Join("&", query);

            tasks = await Http.GetFromJsonAsync<List<VolunteerTaskDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod dohvaćanja zadataka: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilters()
    {
        searchString = string.Empty;
        selectedStatus = null;
        selectedTypeId = null;
        selectedVolunteerId = null;
        selectedAnimalId = null;
        dueFrom = null;
        dueTo = null;
        onlyOverdue = false;

        await LoadTasks();
    }

    private bool TaskMatchesSearch(VolunteerTaskDto task)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return task.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || task.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || task.Type.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || task.Status.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || task.VolunteerName.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || task.AnimalName.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }

    private bool TaskMatchesDate(VolunteerTaskDto task)
    {
        if (dueFrom.HasValue && (task.DueDate is null || task.DueDate.Value.Date < dueFrom.Value.Date))
            return false;
        if (dueTo.HasValue && (task.DueDate is null || task.DueDate.Value.Date > dueTo.Value.Date))
            return false;
        return true;
    }

    private bool TaskMatchesOverdue(VolunteerTaskDto task)
    {
        if (!onlyOverdue)
            return true;
        return IsOverdue(task);
    }

    private bool IsOverdue(VolunteerTaskDto task)
    {
        return task.DueDate.HasValue
            && task.DueDate.Value.Date < DateTime.Today
            && task.Status != "Završeno"
            && task.Status != "Otkazano";
    }

    private async Task DeleteTask(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Jeste li sigurni da želite obrisati ovaj zadatak?");
        if (!confirmed)
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/volunteertasks/{id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Zadatak nije moguće obrisati.";
                return;
            }

            successMessage = "Zadatak je uspješno obrisan.";
            await LoadTasks();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod brisanja zadatka: {ex.Message}";
        }
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "Otvoren" => Color.Info,
            "Dodijeljen" => Color.Primary,
            "U tijeku" => Color.Warning,
            "Završeno" => Color.Success,
            "Otkazano" => Color.Error,
            _ => Color.Default
        };
    }
}